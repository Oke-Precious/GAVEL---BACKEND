{
  "info": {
    "_postman_id": "95aa8744-38bd-46cc-91b5-gavel-api-tests",
    "name": "GAVEL API - Pre-deployment Tests",
    "description": "Run folders in order. This collection covers email verification, contact reporting, admin permissions, super-admin permissions, and safe user deletion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health check returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Service is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rendered API documentation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseOrigin}}/docs",
              "host": ["{{baseOrigin}}"],
              "path": ["docs"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Documentation returns HTML', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "  pm.expect(pm.response.text()).to.include('GAVEL API');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication and email",
      "item": [
        {
          "name": "Register volunteer lawyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Lawyer\",\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"{{signupPassword}}\",\n  \"role\": \"lawyer\",\n  \"barNumber\": \"POSTMAN/TEST/001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('A real signup inbox has been configured', () => {",
                  "  pm.expect(pm.environment.get('signupEmail')).not.to.include('replace-with-a-real-inbox');",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Response uses success contract', () => pm.expect(json.success).to.eql(true));",
                  "if (json.data && json.data.user) pm.environment.set('signupUserId', json.data.user._id);",
                  "console.log('Registration message:', json.message);"
                ]
              }
            }
          ]
        },
        {
          "name": "Public admin signup is forbidden",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Forbidden\",\n  \"lastName\": \"Admin\",\n  \"email\": \"forbidden-admin@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Public admin signup returns 403', () => pm.response.to.have.status(403));",
                  "pm.test('Clear role-policy message is returned', () => pm.expect(pm.response.json().message).to.eql('Public signup is only available for volunteer lawyers.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend verification email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{signupEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-verification",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "resend-verification"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resend succeeds for an unverified account', () => pm.response.to.have.status(200));",
                  "pm.test('Success response is returned', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email using token",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email/{{verificationToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-email", "{{verificationToken}}"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verification token is configured', () => pm.expect(pm.environment.get('verificationToken')).not.to.be.empty);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Email verification succeeds', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login super admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Super-admin login succeeds', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Role is super_admin', () => pm.expect(json.data.user.role).to.eql('super_admin'));",
                  "pm.environment.set('superAdminToken', json.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeds', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Role is admin', () => pm.expect(json.data.user.role).to.eql('admin'));",
                  "pm.environment.set('adminToken', json.data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Contact and issue reporting",
      "item": [
        {
          "name": "Submit public contact message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{signupEmail}}\",\n  \"category\": \"report_issue\",\n  \"message\": \"Postman pre-deployment contact endpoint test.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contact",
              "host": ["{{baseUrl}}"],
              "path": ["contact"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Contact message is persisted', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('contactMessageId', json.data.messageId);"
                ]
              }
            }
          ]
        },
        {
          "name": "List contact inbox as admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/contact/messages?page=1&limit=20&status=new&category=report_issue",
              "host": ["{{baseUrl}}"],
              "path": ["contact", "messages"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "new" },
                { "key": "category", "value": "report_issue" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin can read contact inbox', () => pm.response.to.have.status(200));",
                  "pm.test('Pagination is returned', () => pm.expect(pm.response.json().data.pagination).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Move contact message to in review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_review\",\n  \"adminNotes\": \"Verified through the pre-deployment Postman collection.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/contact/messages/{{contactMessageId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["contact", "messages", "{{contactMessageId}}", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin can update contact status', () => pm.response.to.have.status(200));",
                  "pm.test('Status is in_review', () => pm.expect(pm.response.json().data.message.status).to.eql('in_review'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Ordinary-user lifecycle",
      "item": [
        {
          "name": "Admin invites disposable lawyer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Disposable\",\n  \"lastName\": \"Lawyer\",\n  \"email\": \"{{deleteTargetEmail}}\",\n  \"role\": \"lawyer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/invite",
              "host": ["{{baseUrl}}"],
              "path": ["users", "invite"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin can create an ordinary user', () => pm.response.to.have.status(201));",
                  "pm.environment.set('deleteTargetId', pm.response.json().data.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin edits ordinary user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"+2348000000001\",\n  \"barNumber\": \"POSTMAN/CLEANUP/001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{deleteTargetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{deleteTargetId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Admin can edit ordinary user', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Admin suspends ordinary user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman permission test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{deleteTargetId}}/suspend",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{deleteTargetId}}", "suspend"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Admin can suspend ordinary user', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Admin reactivates ordinary user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/{{deleteTargetId}}/reactivate",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{deleteTargetId}}", "reactivate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Admin can reactivate ordinary user', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Admin deletion is forbidden",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Testing that admins cannot delete\",\n  \"confirmation\": \"DELETE {{deleteTargetEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{deleteTargetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{deleteTargetId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Admin deletion returns 403', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "Super admin checks ordinary-user deletion",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{superAdminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/{{deleteTargetId}}/deletion-check",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{deleteTargetId}}", "deletion-check"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deletion preflight returns 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Disposable user can be deleted', () => pm.expect(json.data.canDelete).to.eql(true));",
                  "pm.environment.set('deleteConfirmation', json.data.requiredConfirmation);"
                ]
              }
            }
          ]
        },
        {
          "name": "Super admin deletes ordinary user",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Removing disposable account after Postman testing\",\n  \"confirmation\": \"{{deleteConfirmation}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{deleteTargetId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{deleteTargetId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Super admin can delete eligible user', () => pm.response.to.have.status(200));",
                  "pm.test('Deleted email is returned', () => pm.expect(pm.response.json().data.deletedEmail).to.eql(pm.environment.get('deleteTargetEmail')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
