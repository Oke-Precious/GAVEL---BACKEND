    {
      "name": "6. Signup-account cleanup",
      "item": [
        {
          "name": "Check signup account deletion",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{superAdminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/{{signupUserId}}/deletion-check",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{signupUserId}}", "deletion-check"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signup cleanup preflight returns 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Unassigned signup account can be deleted', () => pm.expect(json.data.canDelete).to.eql(true));",
                  "pm.environment.set('signupDeleteConfirmation', json.data.requiredConfirmation);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete signup account and free email",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Removing signup account after verification email testing\",\n  \"confirmation\": \"{{signupDeleteConfirmation}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{signupUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{signupUserId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signup account is deleted', () => pm.response.to.have.status(200));",
                  "pm.test('Signup email is now reusable', () => pm.expect(pm.response.json().data.deletedEmail).to.eql(pm.environment.get('signupEmail')));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
