# Application
PORT=1940
NODE_ENV=development
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:1940

# Database
MONGO_URI=your_mongodb_atlas_connection_string

# Authentication (use separate, long, randomly generated secrets)
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Brevo transactional SMTP
# Copy the Login value from Brevo: Settings > SMTP & API > SMTP.
# Use a Brevo SMTP key for EMAIL_PASS, not an API key or account password.
# EMAIL_FROM must be a sender verified in Brevo. A free Gmail sender is acceptable
# for development; a DKIM/DMARC-authenticated custom domain is recommended in production.
# Do not set EMAIL_SERVICE when using EMAIL_HOST.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your-brevo-smtp-login@smtp-brevo.com
EMAIL_PASS=your-brevo-smtp-key
EMAIL_FROM="GAVEL <your-verified-sender@example.com>"

# Recipient for notifications created by POST /api/v1/contact
CONTACT_NOTIFICATION_EMAIL=your-admin-recipient@example.com

# Super-admin bootstrap (used only by: npm run create-super-admin)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace_with_at_least_12_characters
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Super Admin

# Global API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
