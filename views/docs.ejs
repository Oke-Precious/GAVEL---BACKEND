<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Complete API reference for the GAVEL court case management backend.">
    <title>GAVEL API Documentation</title>
    <style>
        :root {
            color-scheme: dark;
            --page: #08111f;
            --panel: #101c2f;
            --panel-soft: #0d1829;
            --sidebar: rgba(8, 17, 31, 0.96);
            --text: #eef4ff;
            --muted: #9eacc2;
            --border: #263650;
            --accent: #a78bfa;
            --accent-strong: #8b5cf6;
            --link: #7dd3fc;
            --get: #34d399;
            --post: #60a5fa;
            --patch: #fbbf24;
            --delete: #fb7185;
            --success: #86efac;
            --warning: #fde68a;
            --danger: #fda4af;
            --code: #07101d;
            --sidebar-width: 292px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 24px;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background:
                radial-gradient(circle at top left, rgba(124, 58, 237, 0.14), transparent 34rem),
                radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.10), transparent 38rem),
                var(--page);
            color: var(--text);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            font-size: 15px;
            line-height: 1.65;
        }

        a {
            color: var(--link);
        }

        a:focus-visible,
        summary:focus-visible {
            border-radius: 6px;
            outline: 3px solid rgba(125, 211, 252, 0.45);
            outline-offset: 3px;
        }

        .skip-link {
            position: fixed;
            top: 12px;
            left: 12px;
            z-index: 100;
            padding: 0.65rem 0.9rem;
            border-radius: 8px;
            background: var(--text);
            color: var(--page);
            transform: translateY(-150%);
        }

        .skip-link:focus {
            transform: translateY(0);
        }

        .sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            z-index: 20;
            width: var(--sidebar-width);
            overflow-y: auto;
            padding: 1.5rem 1.25rem;
            border-right: 1px solid var(--border);
            background: var(--sidebar);
            backdrop-filter: blur(18px);
        }

        .brand {
            display: block;
            margin-bottom: 0.25rem;
            color: var(--text);
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            text-decoration: none;
        }

        .brand span {
            color: var(--accent);
        }

        .sidebar-subtitle {
            margin: 0 0 1.35rem;
            color: var(--muted);
            font-size: 0.78rem;
        }

        .nav-label {
            margin: 1.15rem 0 0.4rem;
            color: #6f8099;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .toc {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .toc li {
            margin: 0.13rem 0;
        }

        .toc a {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.38rem 0.6rem;
            border-radius: 7px;
            color: var(--muted);
            font-size: 0.84rem;
            font-weight: 550;
            text-decoration: none;
            transition: background 150ms ease, color 150ms ease, transform 150ms ease;
        }

        .toc a:hover {
            color: var(--text);
            background: rgba(167, 139, 250, 0.1);
            transform: translateX(3px);
        }

        .toc-number {
            min-width: 1.35rem;
            color: #7688a2;
            font-size: 0.72rem;
            font-variant-numeric: tabular-nums;
        }

        .sidebar-meta {
            margin-top: 1.5rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border);
            color: #7688a2;
            font-size: 0.72rem;
            overflow-wrap: anywhere;
        }

        .mobile-toc {
            display: none;
        }

        main {
            width: min(1180px, calc(100% - var(--sidebar-width)));
            margin-left: var(--sidebar-width);
            padding: 3rem clamp(1.5rem, 5vw, 4.5rem) 5rem;
        }

        section {
            margin-top: 4rem;
            scroll-margin-top: 1.5rem;
        }

        section:first-child {
            margin-top: 0;
        }

        .hero {
            padding: clamp(1.5rem, 4vw, 2.75rem);
            border: 1px solid var(--border);
            border-radius: 20px;
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.16), rgba(14, 165, 233, 0.08));
            box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
        }

        .eyebrow {
            margin: 0 0 0.5rem;
            color: var(--accent);
            font-size: 0.76rem;
            font-weight: 800;
            letter-spacing: 0.13em;
            text-transform: uppercase;
        }

        h1,
        h2,
        h3 {
            color: var(--text);
            line-height: 1.25;
        }

        h1 {
            max-width: 760px;
            margin: 0;
            font-size: clamp(2rem, 5vw, 3.35rem);
            letter-spacing: -0.045em;
        }

        h2 {
            display: flex;
            align-items: baseline;
            gap: 0.55rem;
            margin: 0 0 1rem;
            padding-bottom: 0.65rem;
            border-bottom: 1px solid var(--border);
            font-size: clamp(1.45rem, 3vw, 2rem);
            letter-spacing: -0.025em;
        }

        h3 {
            margin: 0 0 0.75rem;
            font-size: 1.02rem;
        }

        .heading-link {
            color: #64748b;
            font-size: 0.75em;
            text-decoration: none;
            opacity: 0;
            transition: opacity 150ms ease;
        }

        h2:hover .heading-link,
        h2:focus-within .heading-link {
            opacity: 1;
        }

        p {
            margin: 0 0 1rem;
            color: var(--muted);
        }

        strong {
            color: #dce8fa;
        }

        .lead {
            max-width: 790px;
            margin: 0.85rem 0 1.35rem;
            color: #c7d3e7;
            font-size: 1.04rem;
        }

        .quick-links,
        .base-grid,
        .demo-grid,
        .response-grid {
            display: grid;
            gap: 0.8rem;
        }

        .quick-links {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            margin-top: 1.35rem;
        }

        .quick-link {
            padding: 0.9rem 1rem;
            border: 1px solid var(--border);
            border-radius: 11px;
            background: rgba(7, 16, 29, 0.5);
            color: #c9d7eb;
            font-size: 0.82rem;
            font-weight: 700;
            text-decoration: none;
        }

        .quick-link:hover {
            border-color: var(--accent-strong);
            color: white;
        }

        .base-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .base-url,
        .demo-card {
            padding: 0.85rem 1rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--panel-soft);
        }

        .base-url span,
        .demo-card span {
            display: block;
            margin-bottom: 0.22rem;
            color: #7688a2;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .base-url code {
            word-break: break-all;
        }

        .card {
            margin-top: 1rem;
            padding: 1.25rem;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: rgba(16, 28, 47, 0.74);
            box-shadow: 0 10px 36px rgba(0, 0, 0, 0.12);
        }

        .card > :last-child {
            margin-bottom: 0;
        }

        .callout {
            margin: 1rem 0;
            padding: 0.85rem 1rem;
            border: 1px solid rgba(96, 165, 250, 0.25);
            border-left: 4px solid var(--post);
            border-radius: 8px;
            background: rgba(59, 130, 246, 0.08);
            color: #bdd7fa;
        }

        .callout.warning {
            border-color: rgba(251, 191, 36, 0.25);
            border-left-color: var(--patch);
            background: rgba(245, 158, 11, 0.08);
            color: var(--warning);
        }

        .callout.success {
            border-color: rgba(52, 211, 153, 0.25);
            border-left-color: var(--get);
            background: rgba(16, 185, 129, 0.08);
            color: var(--success);
        }

        code,
        pre {
            font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        }

        code {
            padding: 0.12rem 0.35rem;
            border: 1px solid rgba(148, 163, 184, 0.13);
            border-radius: 5px;
            background: rgba(7, 16, 29, 0.76);
            color: #d6e3f6;
            font-size: 0.86em;
        }

        pre {
            margin: 0.75rem 0 1rem;
            padding: 1rem 1.1rem;
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--code);
            color: #c4b5fd;
            font-size: 0.84rem;
            line-height: 1.58;
            tab-size: 2;
        }

        pre code {
            padding: 0;
            border: 0;
            background: transparent;
            color: inherit;
            font-size: inherit;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        table {
            width: 100%;
            min-width: 760px;
            border-collapse: collapse;
            background: rgba(13, 24, 41, 0.55);
        }

        th,
        td {
            padding: 0.82rem 0.9rem;
            border-bottom: 1px solid var(--border);
            text-align: left;
            vertical-align: top;
        }

        th {
            background: rgba(7, 16, 29, 0.72);
            color: #8798b1;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        td {
            color: #b8c6da;
            font-size: 0.84rem;
        }

        tr:last-child td {
            border-bottom: 0;
        }

        tbody tr:hover {
            background: rgba(167, 139, 250, 0.035);
        }

        .method,
        .access {
            display: inline-block;
            white-space: nowrap;
            border-radius: 999px;
            font-size: 0.66rem;
            font-weight: 850;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .method {
            min-width: 4.1rem;
            padding: 0.22rem 0.55rem;
            text-align: center;
        }

        .method.get {
            border: 1px solid rgba(52, 211, 153, 0.35);
            background: rgba(16, 185, 129, 0.12);
            color: var(--get);
        }

        .method.post {
            border: 1px solid rgba(96, 165, 250, 0.35);
            background: rgba(59, 130, 246, 0.12);
            color: var(--post);
        }

        .method.patch {
            border: 1px solid rgba(251, 191, 36, 0.35);
            background: rgba(245, 158, 11, 0.12);
            color: var(--patch);
        }

        .method.delete {
            border: 1px solid rgba(251, 113, 133, 0.35);
            background: rgba(244, 63, 94, 0.12);
            color: var(--delete);
        }

        .access {
            padding: 0.18rem 0.48rem;
            border: 1px solid var(--border);
            color: #aebcd0;
        }

        .demo-grid {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }

        .demo-card code {
            display: block;
            padding: 0;
            border: 0;
            background: transparent;
            word-break: break-all;
        }

        .badge-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin: 0.75rem 0 1rem;
        }

        .badge {
            padding: 0.3rem 0.6rem;
            border: 1px solid rgba(167, 139, 250, 0.28);
            border-radius: 7px;
            background: rgba(139, 92, 246, 0.08);
            color: #c4b5fd;
            font-family: "SFMono-Regular", Consolas, monospace;
            font-size: 0.76rem;
        }

        .response-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .mini-title {
            margin: 1.5rem 0 0.55rem;
            color: #d8e4f7;
            font-size: 0.9rem;
            font-weight: 800;
        }

        .top-link {
            display: inline-block;
            margin-top: 2rem;
            color: var(--muted);
            font-size: 0.82rem;
            text-decoration: none;
        }

        footer {
            margin-top: 4rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border);
            color: #72829a;
            font-size: 0.78rem;
        }

        @media (max-width: 1080px) {
            .quick-links {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .demo-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @media (max-width: 820px) {
            html {
                scroll-padding-top: 76px;
            }

            .sidebar {
                display: none;
            }

            .mobile-toc {
                position: sticky;
                top: 0;
                z-index: 30;
                display: block;
                border-bottom: 1px solid var(--border);
                background: rgba(8, 17, 31, 0.96);
                backdrop-filter: blur(16px);
            }

            .mobile-toc summary {
                padding: 0.9rem 1rem;
                color: var(--text);
                cursor: pointer;
                font-weight: 750;
            }

            .mobile-toc .toc {
                max-height: 65vh;
                overflow-y: auto;
                padding: 0 0.75rem 0.9rem;
            }

            main {
                width: 100%;
                margin-left: 0;
                padding: 1.25rem 1rem 4rem;
            }

            section {
                margin-top: 3rem;
                scroll-margin-top: 76px;
            }

            .base-grid,
            .response-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 560px) {
            .hero {
                padding: 1.25rem;
                border-radius: 14px;
            }

            .quick-links,
            .demo-grid {
                grid-template-columns: 1fr;
            }

            .card {
                padding: 1rem;
            }

            h2 {
                align-items: center;
            }

            .heading-link {
                opacity: 1;
            }
        }

        @media print {
            body {
                background: white;
                color: #111827;
            }

            .sidebar,
            .mobile-toc,
            .skip-link,
            .top-link {
                display: none;
            }

            main {
                width: 100%;
                margin: 0;
                padding: 0;
            }

            section {
                break-inside: avoid;
            }

            .hero,
            .card,
            .table-wrap {
                box-shadow: none;
            }
        }
    </style>
</head>
